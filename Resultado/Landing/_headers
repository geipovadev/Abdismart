# Cabeceras de seguridad. Cloudflare Pages lee este archivo desde la raíz
# del sitio publicado. No aplica al servidor local de desarrollo.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# El logotipo no cambia entre despliegues: se puede cachear con agresividad.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
