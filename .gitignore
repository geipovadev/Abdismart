# ─── Secretos ───────────────────────────────────────────────
# Nunca subir credenciales. Si alguna llega a subirse, hay que
# rotarla: borrarla del historial no basta.
.env
.env.*
.dev.vars
*.pem
*.key

# ─── Documentación de negocio ───────────────────────────────
# Contexto/ tiene la economía unitaria (LTV, CAC, break-even), el roadmap
# y las metas de MRR. El repositorio es privado, pero esto se queda fuera
# igual: si algún día se hace público, es lo primero que se filtra.
# Vive solo en local. Se eliminó del historial el 28/07/2026.
Contexto/

# ─── Datos personales de terceros ───────────────────────────
# El agente de captación guarda negocios reales con nombre, teléfono y
# calificación, recolectados de Google Maps. No se versionan: son datos
# de personas que no son clientes nuestros.
# Los CSV llevan nombre y teléfono de negocios reales; nada de eso se versiona.
# La plantilla de correo y los reportes de ronda —que son agregados, sin
# teléfonos— sí se versionan.
Resultado/agente/leads/
Resultado/agente/correos/*.csv
Resultado/agente/memoria/*.csv

# ─── Proyectos que no son parte de Abdi ─────────────────────
# open-carrusel tiene su propio repo (Hainrixz/open-carrusel).
open-carrusel/
# Agente Contenido queda fuera: contiene .env con llaves de API.
Agente Contenido/
# Skill externo con su propio repo (skills-sh/claude-seo). Se instala aparte.
.claude/skills/

# ─── Dependencias y builds ──────────────────────────────────
node_modules/
.wrangler/
.netlify/
.next/
dist/
build/

# ─── Artefactos de trabajo ──────────────────────────────────
# tmp/ son renders intermedios (PNG por página, logs, .pyc) de armar PDF.
# output/ es el kit del agente ya empaquetado: la fuente está en
# abdi-agent-skill/, así que esto se regenera y no se versiona.
tmp/
output/
__pycache__/
*.pyc

# ─── Sistema operativo y editores ───────────────────────────
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# ─── Configuración local de Claude Code ─────────────────────
# settings.json sí se versiona; el .local es de cada máquina.
.claude/settings.local.json

# Caché de graphify: se regenera, no se versiona.
graphify-out/
