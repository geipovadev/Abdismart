      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        2912,
        128
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://graph.instagram.com/v23.0/{{ $('Configuración').first().json.ig_user_id }}/media",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpTemplatedCustomAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ media_type: 'REELS', share_to_feed: true, caption: String($json.caption || '').trim(), video_url: 'https://drive.usercontent.google.com/download?id=' + $('Elegir video, portada y caption').first().json.video_id + '&export=download', cover_url: 'https://lh3.googleusercontent.com/d/' + $('Elegir video, portada y caption').first().json.portada_id }) }}",
        "options": {
          "timeout": 60000
        }
      }
    },
