    {
      "name": "Un reel por vuelta",
      "type": "n8n-nodes-base.limit",
      "typeVersion": 1,
      "position": [
        1120,
        128
      ],
      "parameters": {}
    },
    {
      "name": "Listar archivos de la carpeta",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        1344,
        128
      ],
      "parameters": {
        "resource": "fileFolder",
        "returnAll": true,
        "options": {
          "fields": [
            "id",
            "name",
            "mimeType"
          ]
        },
        "filter": {
          "whatToSearch": "files",
          "folderId": {
            "__rl": true,
            "mode": "id",
            "value": "={{ $json.id }}"
          }
        }
      }
    },
    {
      "name": "Elegir video, portada y caption",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1568,
        128
      ],
      "parameters": {
        "jsCode": "// Busca los tres archivos del reel dentro de la carpeta.\n//\n// Si falta alguno no sale nada y el flujo termina sin publicar. Es a proposito:\n// si Drive todavia esta subiendo el mp4, es mejor esperar al dia siguiente que\n// publicar un reel a medias.\nconst archivos = $input.all().map(i => i.json);\nconst nombre = a => String(a.name || '').toLowerCase();\n\nconst video = archivos.find(a => nombre(a).endsWith('.mp4') || nombre(a).endsWith('.mov'));\nconst imagenes = archivos.filter(a => /\\.(png|jpe?g)$/.test(nombre(a)));\n// Si hay varias imagenes gana la que se llame portada*; si no, la primera.\nconst portada = imagenes.find(a => nombre(a).startsWith('portada')) || imagenes[0];\nconst caption = archivos.find(a => nombre(a) === 'caption.txt') || archivos.find(a => nombre(a).endsWith('.txt'));\n\nif (!video || !portada || !caption) return [];\n\nconst carpeta = $('Un reel por vuelta').first().json;\nreturn [{ json: {\n  carpeta_id: carpeta.id,\n  carpeta: carpeta.name,\n  video_id: video.id,\n  video: video.name,\n  portada_id: portada.id,\n  caption_id: caption.id,\n} }];"
      }
    },
    {
      "name": "Apuntar la carpeta antes de publicar",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        1792,
        128
      ],
      "parameters": {
        "dataTableId": {
          "__rl": true,
          "mode": "list",
          "value": "",
          "cachedResultName": "reels_publicados"
        },
        "options": {},
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "carpeta_id": "={{ $json.carpeta_id }}",
            "carpeta": "={{ $json.carpeta }}",
            "estado": "publicando"
          },
          "schema": [
            {
              "id": "carpeta_id",
              "displayName": "carpeta_id",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "carpeta",
              "displayName": "carpeta",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "estado",
              "displayName": "estado",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            }
          ]
        }
      }
    },
